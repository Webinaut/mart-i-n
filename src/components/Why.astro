---
import Image from "astro/components/Image.astro";
import Computerframe from "../images/computer.png";
import slide1 from "../images/ranges.png";
import slide2 from "../images/rplgc.png";
import slide3 from "../images/member.png";
import slide4 from "../images/OTA.png";
import slide5 from "../images/shearing-shed.png";
import slide6 from "../images/plk.png";
import slide7 from "../images/mpi.png";
import slide8 from "../images/murphy-fresh.png";

const framedImages = [
  {
    src: slide1,
    alt: "slide1",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide2,
    alt: "slide2",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide3,
    alt: "slide3",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide4,
    alt: "slide4",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide5,
    alt: "slide5",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide6,
    alt: "slide6",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide7,
    alt: "slide7",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
  {
    src: slide8,
    alt: "slide8",
    width: 1535,
    height: 955,
    class: "slider__slide",
  },
];
---

<div class="curved-top-border">
  <svg
    class="curved-top-border__curve"
    viewBox="0 0 1440 133"
    preserveAspectRatio="none"
  >
    <g>
      <path
        id="path-1"
        d="M-0,72s180-36.13230792814181 360-0 180-136.8176787775407 360-0 180-111.71350672592155 360-0 180-16.099548216277995 360-0 V144H-1440Z"
        fill="#425E5E"></path>
      <path
        id="path-2"
        d="M-0,72s180-111.8581060065802 360-0 180-15.871579969997365 360-0 180-129.00900851770052 360-0 180-123.53614958975476 360-0 V144H-1440Z"
        fill="#425E5E"
        style="opacity: 0;"></path>
    </g>
  </svg>
</div>
<section class="section__wrapper">
  <div id="why" class="section__content">
    <div class="pure-g">
      <!-- Pure CSS Grid (Actually Flex) -->
      <h1 class="why__title pure-u-md-2-5">
        <!-- Pure CSS two fifths on larger screens -->
        Why
        <span class="section__content--white-text"
          ><br />
          Revitalise?
        </span>
      </h1>
      <p class="why__text section__content--white-text pure-u-md-3-5">
        <!-- Pure CSS three fifths on larger screens -->
        A modern website encourages visitors to stay longer and find what they need.
        A fresh look reinforces professionalism and relevance. It can yield significant
        returns.
      </p>
    </div>
    <div class="slider">
      <Image src={Computerframe} alt="Computer Frame" class="slider__frame" />
      {
        framedImages.map((image) => (
          <Image
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            class={image.class}
          />
        ))
      }
    </div>

    <div class="button__centered">
      <a href="https://onestopsites.net.au/portfolio/" target="_blank"
        ><button class="button__primary">View Mart.I.N's Portfolio</button></a
      >
    </div>
  </div>
</section>
<style lang="scss">
  .curved-top-border {
    position: relative;
    background: var(--pure-secondary-bg);
    padding-bottom: 8rem;
    &__curve {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      max-width: 100vw;
      height: 132px;
      color: var(--pure-primary-bg);
    }
  }
  .why__title {
    font-size: 4em;
  }
  .why__text {
    align-content: center;
  }
  .slider {
    position: relative;
    margin: 1em auto 0 auto;
    &__frame {
      display: flex;
      justify-self: center;
      max-width: 80%;
      max-height: fit-content;
      object-fit: contain;
    }
    &__slide {
      object-fit: contain;
      max-width: 80%;
      max-height: fit-content;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      opacity: 0;
    }
  }

  @media screen and (max-width: 768px) {
    .curved-top-border {
      padding-bottom: 2rem;
      &__curve {
        height: 36px;
      }
    }
    .slider__frame,
    .slider__slide {
      max-width: 100%;
    }
  }
</style>
<script>
  import { onScroll, animate, svg, stagger, linear } from "animejs";
  const path1 = document.getElementById("path-1");
  const path2 = document.getElementById("path-2");
  function animateCurve() {
    // Morph #path-1 into #path-2
    animate(path1, {
      d: svg.morphTo(path2),
      ease: linear(0, "0.5 50%", "0.7 75%", 1),
      duration: 3000,
      alternate: true,
      autoplay: onScroll({
        container: "curved-border",
        sync: 1,
        enter: "max bottom",
        leave: "min top",
      }),
    });
  }
  animateCurve();

  function animateImagesSequentially() {
    animate(".slider__slide", {
      // Select all images
      opacity: [0, 1], // Animate from opacity 0 to 1
      duration: 800, // Duration of each individual fade in (ms)
      delay: stagger(3000, { start: 100 }),
      easing: "easeInOutQuad",
      loop: true, // Loop the animation
      direction: "alternate", // Reverse the animation back
      // Optionally, add a loop delay or other properties
      loopDelay: 3500,
    });
  }
  animateImagesSequentially();
</script>
