---
import Image from "astro/components/Image.astro";
import ui from "../images/ui.svg";
import branding from "../images/branding.svg";
import marketing from "../images/marketing.svg";
import revenue from "../images/revenue.svg";
---

<section class="section__wrapper section__content benefits">
  <h1 class="benefits__title">The Benefits to You</h1>
  <div class="pure-g">
    <!-- Pure CSS Grid (Actually Flex) -->
    <figure class="benefits__text pure-u-1 pure-u-md-1-2 pure-u-lg-1-4">
      <Image src={ui} alt="ui" />
      <figcaption>Enhanced User Experience (UX)</figcaption>
    </figure>
    <figure class="benefits__text pure-u-1 pure-u-md-1-2 pure-u-lg-1-4">
      <Image src={branding} alt="branding" />
      <figcaption>Stronger Brand Perception & Trust</figcaption>
    </figure>
    <figure class="benefits__text pure-u-1 pure-u-md-1-2 pure-u-lg-1-4">
      <Image src={marketing} alt="marketing" />
      <figcaption>Improved Marketing & SEO Performance</figcaption>
    </figure>
    <figure class="benefits__text pure-u-1 pure-u-md-1-2 pure-u-lg-1-4">
      <Image src={revenue} alt="revenue" />
      <figcaption>Increased Conversions & Revenue</figcaption>
    </figure>
  </div>
</section>

<style lang="scss">
  .benefits {
    background-color: unset;
    padding-bottom: 60px;
    &__title {
      text-align: center;
      margin-top: 2em;
      font-size: 3.6em;
    }
    &__text {
      text-align: center;
    }
  }
  .pure-g {
    margin: 4em 0;
  }
</style>
